# Gemini API (https://ai.google.dev/gemini-api/docs/api-key)
GEMINI_API_KEY=

# Groq API (https://console.groq.com/docs/quickstart)
# Add up to N keys as GROQ_API_KEY, GROQ_API_KEY_2, GROQ_API_KEY_3, ...
# The router tries all keys for the highest-priority model before downgrading.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
