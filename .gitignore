node_modules/
dist/

# Local secrets — never commit.
.env

# Captured evidence from previous runs: screenshots, traces and generated
# .docx files. Regenerated by every run and hundreds of MB in size.
output/

# Saved browser sessions — these hold live authentication cookies/tokens
# for the target systems and must never be committed.
auth/.storage/

*.log
.DS_Store
Thumbs.db

# Claude Code's own tool configuration — machine/session-local, not part of
# this project's source.
.claude/

# External SAP documentation, sparse-cloned locally for research reference
# only — not part of this project's source, and its own nested .git makes it
# a separate repository, not something to vendor into this one.
sapui5/
